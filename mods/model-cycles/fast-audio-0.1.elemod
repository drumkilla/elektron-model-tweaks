{
 "elemod": 2,
 "id": "fast-audio",
 "version": "0.1",
 "title": "Fast audio",
 "description": "Runs the audio render's hot code (the voices, the mix and the effects) from the on-chip SRAM instead of DDR, for more CPU left to the UI. Same code, same sound. CHORD reads its wavetables from DDR instead.",
 "category": "Performance",
 "author": "drumkilla",
 "license": "MIT",
