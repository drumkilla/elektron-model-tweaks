{
 "elemod": 2,
 "id": "modkit",
 "version": "0.2",
 "title": "modkit",
 "description": "The base for other mods: project data saved with the project (mk_projdata), menu items in Track Setup and CONFIG > Device (mk_items), the voice's sample fetch (mk_voice_fetch), Track Setup's stretch/stereo bytes, track data per pattern (mk_tdata), pages (mk_pages), device data in a file on the +Drive (mk_devdata), p-locks of mods' own settings on steps (mk_lock). Changes nothing on its own.",
 "category": "Framework",
 "author": "drumkilla",
 "license": "MIT",
 "target": {
  "device": "model-samples",
  "product": "Model:Samples",
  "os": "1.13",
